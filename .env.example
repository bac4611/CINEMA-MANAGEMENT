# Copy to /opt/cinema/.env and chmod 600. Never commit the completed file.
# Put literal values containing $ or # inside single quotes.
CINEMA_IMAGE_TAG=
CINEMA_HTTP_PORT=8080
# Never enable dev/development: these profiles bypass authentication or seed accounts.
SPRING_PROFILES_ACTIVE=production
# Set your real SQL Server DNS name and existing database; SQL authentication on Linux.
# jdbc:sqlserver://<sql-server-dns>:1433;databaseName=MovieTicketDB;encrypt=true;trustServerCertificate=false
SPRING_DATASOURCE_URL=
SPRING_DATASOURCE_USERNAME=
SPRING_DATASOURCE_PASSWORD=
# Generate with: openssl rand -hex 32
JWT_KEY=

# Optional features: uncomment and configure on the VPS when needed.
# SPRING_MAIL_HOST=
# SPRING_MAIL_PORT=587
# SPRING_MAIL_USERNAME=
# SPRING_MAIL_PASSWORD=
# SPRING_MAIL_PROPERTIES_MAIL_SMTP_AUTH=true
# SPRING_MAIL_PROPERTIES_MAIL_SMTP_STARTTLS_ENABLE=true
# SPRING_MAIL_PROPERTIES_MAIL_SMTP_STARTTLS_REQUIRED=true
# For Google also use SPRING_PROFILES_ACTIVE=production,google
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# SEPAY_WEBHOOKAPIKEY=
# SEPAY_BANKACCOUNTNUMBER=
# SEPAY_BANKCODE=
